<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.hqu.csmall.product.mapper.AttributeTemplateMapper">

    <select id="list" resultType="cn.hqu.csmall.product.pojo.vo.AttributeTemplateListItemVO">
            SELECT id,name,sort,pinyin,keywords
            FROM pms_attribute_template ORDER BY sort
    </select>

    <select id="getStandardById" resultType="cn.hqu.csmall.product.pojo.vo.AttributeTemplateStandardVO">
            SELECT id,name,pinyin,sort,keywords
            FROM pms_attribute_template WHERE id=#{id}
    </select>

    <select id="search" resultType="cn.hqu.csmall.product.pojo.vo.AttributeTemplateListItemVO">
            SELECT id,name,keywords,pinyin,sort
            FROM pms_attribute_template WHERE 1=1
            <if test="name != null and name != ''"> AND name=#{name}</if>
            <if test="id != null"> AND id=#{id}</if>
            ORDER BY sort
    </select>

</mapper>
