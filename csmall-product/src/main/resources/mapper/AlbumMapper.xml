<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.hqu.csmall.product.mapper.AlbumMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO pms_album(name,description,sort,gmt_Create,gmt_Modified) VALUES(#{name},#{description},#{sort},#{gmtCreated},#{gmtModified})
    </insert>

    <select id="list" resultType="cn.hqu.csmall.product.pojo.vo.AlbumListItemVO">
            SELECT id,name,description,sort
            FROM pms_album ORDER BY sort
    </select>

    <select id="search" resultType="cn.hqu.csmall.product.pojo.vo.AlbumListItemVO">
        SELECT id, name, description, sort
        FROM pms_album
        WHERE 1=1
        <if test="name != null and name != ''">
            AND name LIKE CONCAT('%', #{name}, '%')
        </if>
        <if test="id != null">
            AND id = #{id}
        </if>
        ORDER BY sort
    </select>

    <select id="getStandardById" resultType="cn.hqu.csmall.product.pojo.vo.AlbumStandardVO">
            SELECT id,name,description,sort
            FROM pms_album WHERE id=#{id}
    </select>

</mapper>
