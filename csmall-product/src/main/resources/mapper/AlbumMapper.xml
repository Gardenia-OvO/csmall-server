<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.hqu.csmall.product.mapper.AlbumMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO pms_album(name,description,sort,gmt_Create,gmt_Modified) VALUES(#{name},#{description},#{sort},#{gmtCreated},#{gmtModified})
    </insert>
</mapper>
